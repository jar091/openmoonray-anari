# Normalize line endings: LF in the repository, native in the working tree
* text=auto

# Shell scripts must stay LF even on Windows checkouts
*.sh text eol=lf

# PowerShell scripts are fine with CRLF
*.ps1 text eol=crlf

# Binary test fixtures
*.exr binary
*.png binary
*.jpg binary
*.rdlb binary
*.vdb binary
*.diff -text
